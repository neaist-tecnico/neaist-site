RewriteCond %{REQUEST_URI} !^/dia\-de\-africa\.html$
RewriteRule ^dia\-de\-africa(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/dia-de-africa.html [R=301,L,NC]
RewriteCond %{REQUEST_URI} !^/semana\-africa\-ulisboa\.html$
RewriteRule ^semana\-africa\-ulisboa(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/semana-africa-ulisboa.html [R=301,L,NC]
RewriteCond %{REQUEST_URI} !^/noticia\-tomada\-posse\-2026\.html$
RewriteRule ^noticia\-tomada\-posse\-2026(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/noticia-tomada-posse-2026.html [R=301,L,NC]
RewriteCond %{REQUEST_URI} !^/noticia\-game\-day\-2026\.html$
RewriteRule ^noticia\-game\-day\-2026(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/noticia-game-day-2026.html [R=301,L,NC]
RewriteCond %{REQUEST_URI} !^/galeria\.html$
RewriteRule ^galeria(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/galeria.html [R=301,L,NC]
RewriteCond %{REQUEST_URI} !^/loja\.html$
RewriteRule ^loja(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/loja.html [R=301,L,NC]
RewriteCond %{REQUEST_URI} !^/contactos\.html$
RewriteRule ^contactos(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/contactos.html [R=301,L,NC]

# Aliases above already include HTTPS, avoiding HTTP -> alias -> canonical chains.
# The TLS proxy must supply a trusted X-Forwarded-Proto header (see hosting.md).
RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^neaist\.tecnico\.ulisboa\.pt$ [NC]
RewriteRule ^ https://neaist.tecnico.ulisboa.pt%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^neaist\.tecnico\.ulisboa\.pt$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://neaist.tecnico.ulisboa.pt%{REQUEST_URI} [R=301,L,NE]
