RewriteRule "^files/Guia\-2\-Proximos\-Passos\-Caloiros\.pdf$" https://neaist.tecnico.ulisboa.pt/files/caloiros/2026-2027/guia-novos-alunos-neaist-2026-2027.pdf [R=301,L,QSD,NC]
RewriteRule "^files/GUIA PARA NOVOS ALUNOS NEAIST\.docx \(1\)\.pdf$" https://neaist.tecnico.ulisboa.pt/files/caloiros/2026-2027/guia-novos-alunos-neaist-2026-2027.pdf [R=301,L,QSD,NC]

# Canonical homepage; THE_REQUEST avoids redirecting DirectoryIndex internally.
RewriteCond %{THE_REQUEST} \s/+index\.(?:html?|php)(?:[?\s/]) [NC]
RewriteRule ^index\.(?:html?|php)/?$ https://neaist.tecnico.ulisboa.pt/ [R=301,L,NC]

# Known page aliases only: extensionless, trailing slash and case variants.
RewriteCond %{REQUEST_URI} !^/sobre\-nos\.html$
RewriteRule ^sobre\-nos(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/sobre-nos.html [R=301,L,NC]
