RewriteRule ^recursos(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/recursos.html [R=301,L,NC]
RewriteCond %{REQUEST_URI} !^/study\-squads\.html$
RewriteRule ^study\-squads(?:\.html)?/?$ https://neaist.tecnico.ulisboa.pt/study-squads.html [R=301,L,NC]
RewriteCond %{REQUEST_URI} !^/mentoria\.html$
