RewriteRule ^(?:index\.(?:php|html?))?/?$ https://neaist.tecnico.ulisboa.pt/recursos.html [R=301,L,QSD,NC]
RewriteRule ^index\.html\?p=27\.html$ https://neaist.tecnico.ulisboa.pt/recursos.html [R=301,L,QSD,NC]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=29(?:\.html)?(?:&|$) [NC]
RewriteRule ^(?:index\.(?:php|html?))?/?$ https://neaist.tecnico.ulisboa.pt/guia-caloiro.html [R=301,L,QSD,NC]
RewriteRule ^index\.html\?p=29\.html$ https://neaist.tecnico.ulisboa.pt/guia-caloiro.html [R=301,L,QSD,NC]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=252(?:\.html)?(?:&|$) [NC]
RewriteRule ^(?:index\.(?:php|html?))?/?$ https://neaist.tecnico.ulisboa.pt/galeria.html [R=301,L,QSD,NC]
RewriteRule ^index\.html\?p=252\.html$ https://neaist.tecnico.ulisboa.pt/galeria.html [R=301,L,QSD,NC]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=544(?:\.html)?(?:&|$) [NC]
RewriteRule ^(?:index\.(?:php|html?))?/?$ https://neaist.tecnico.ulisboa.pt/mentoria.html [R=301,L,QSD,NC]
RewriteRule ^index\.html\?p=544\.html$ https://neaist.tecnico.ulisboa.pt/mentoria.html [R=301,L,QSD,NC]
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=737(?:\.html)?(?:&|$) [NC]
RewriteRule ^(?:index\.(?:php|html?))?/?$ https://neaist.tecnico.ulisboa.pt/noticias.html [R=301,L,QSD,NC]
RewriteRule ^index\.html\?p=737\.html$ https://neaist.tecnico.ulisboa.pt/noticias.html [R=301,L,QSD,NC]

# Unknown WordPress content has no verified replacement; never send it home.
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=[0-9]+(?:\.html)?(?:&|$) [NC]
RewriteRule ^(?:index\.(?:php|html?))?/?$ - [G,L]
RewriteRule ^index\.html\?p=[0-9]+\.html$ - [G,L,NC]

# Verified legacy routes and documents.
RewriteRule "^wp\-content/uploads/2022/02/Guia\-para\-Novos\-Alunos\.pdf$" https://neaist.tecnico.ulisboa.pt/guia-caloiro.html [R=301,L,QSD,NC]
RewriteRule "^wp\-content/uploads/2022/02/Guia\-1\-Primeiros\-Passos\-Caloiros\-1\.pdf$" https://neaist.tecnico.ulisboa.pt/guia-caloiro.html [R=301,L,QSD,NC]
RewriteRule "^wp\-content/uploads/2022/03/Regulamento\-Mentores\-1\.pdf$" https://neaist.tecnico.ulisboa.pt/guia-caloiro.html [R=301,L,QSD,NC]
