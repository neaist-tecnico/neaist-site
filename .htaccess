# Generated by scripts/build_redirects.py. Apache 2.4; see docs/seo/hosting.md.
# True HTTP redirects require AllowOverride on the AFS virtual host.
Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<FilesMatch "(?i)^(\.env(?:\..*)?|config\.local\.php|.*\.(?:sql|log|bak))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    <FilesMatch "^(google[0-9a-f]+\.html|404\.html)$">
        Header always set X-Robots-Tag "noindex, follow"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Development and source files must not be served if accidentally uploaded.
RewriteRule ^(?:\.git|\.github|docs|scripts)(?:/|$) - [F,L]

# WordPress IDs are mapped BEFORE the index/HTTPS rules (one hop).
RewriteCond %{QUERY_STRING} (?:^|&)(?:p|page_id)=18(?:\.html)?(?:&|$) [NC]
RewriteRule ^(?:index\.(?:php|html?))?/?$ https://neaist.tecnico.ulisboa.pt/ [R=301,L,QSD,NC]
RewriteRule ^index\.html\?p=18\.html$ https://neaist.tecnico.ulisboa.pt/ [R=301,L,QSD,NC]
